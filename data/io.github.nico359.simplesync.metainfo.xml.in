<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nico359.simplesync</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>SimpleSync</name>
  <summary>Push files to Nextcloud via WebDAV</summary>
  <description>
    <p>SimpleSync is a simple file sync tool for Nextcloud and WebDAV servers. Push local folders to your server with incremental uploads and optional mirror mode, or pull remote content down to a local folder.</p>
    <p>It is designed to be lightweight and mobile-friendly, so it works on Linux phones as well as on the desktop.</p>
  </description>

  <developer id="io.github.nico359">
    <name>nico359</name>
  </developer>

  <icon type="stock">io.github.nico359.simplesync</icon>

  <url type="homepage">https://github.com/nico359/simplesync</url>
  <url type="vcs-browser">https://github.com/nico359/simplesync</url>
  <url type="bugtracker">https://github.com/nico359/simplesync/issues</url>

  <categories>
    <category>Utility</category>
  </categories>

  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>
  <supports>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <translation type="gettext">simplesync</translation>
  <launchable type="desktop-id">io.github.nico359.simplesync.desktop</launchable>
  <content_rating type="oars-1.1" />

  <screenshots>
    <screenshot type="default">
      <caption>All configured sync targets</caption>
      <image>https://raw.githubusercontent.com/nico359/simplesync/refs/heads/main/data/overview.png</image>
    </screenshot>
    <screenshot>
      <caption>Add your first sync target</caption>
      <image>https://raw.githubusercontent.com/nico359/simplesync/refs/heads/main/data/targets.png</image>
    </screenshot>
    <screenshot>
      <caption>Connecting a Nextcloud account</caption>
      <image>https://raw.githubusercontent.com/nico359/simplesync/refs/heads/main/data/account.png</image>
    </screenshot>
    <screenshot>
      <caption>Setting up a sync target</caption>
      <image>https://raw.githubusercontent.com/nico359/simplesync/refs/heads/main/data/target_setup.png</image>
    </screenshot>
    <screenshot>
